<?xml version="1.0"?>
<sdf version="1.7">

  <world name="robocon_arena">

    <!-- Physics -->
    <physics name="physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

<!--
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>
-->
    <!-- Arena -->
    <model name="arena">

      <static>true</static>

      <!-- FLOOR -->
      <link name="floor">

        <visual name="floor_visual">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/floor.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>

        </visual>

        <collision name="floor_collision">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/floor.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </collision>

      </link>

      <!-- WALLS -->
      <link name="walls">

        <visual name="walls_visual">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/walls.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>

        </visual>

        <collision name="walls_collision">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/walls.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </collision>

      </link>

      <!-- RAMP -->
      <link name="ramp">

        <visual name="ramp_visual">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/ramp.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>

        </visual>

        <collision name="ramp_collision">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/ramp.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </collision>

      </link>

      <!-- OBSTACLES -->
      <link name="obstacles">

        <visual name="obstacles_visual">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/obstacles.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>

        </visual>

        <collision name="obstacles_collision">

          <pose>0 0 0 1.5707963267948966 0 0</pose>

          <geometry>
            <mesh>
              <uri>meshes/obstacles.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>

        </collision>

      </link>

    </model>

  </world>

</sdf>