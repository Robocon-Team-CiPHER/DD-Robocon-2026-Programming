<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base -->
  <material name="base_color">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>

  <!-- Front / Back Links -->
  <material name="chassis_color">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <!-- Expandable Mechanism -->
  <material name="expandable_color">
    <color rgba="0.1 0.4 0.8 1"/>
  </material>

  <!-- Gantry -->
  <material name="gantry_color">
    <color rgba="0.8 0.5 0.1 1"/>
  </material>

  <!-- Wheels -->
  <material name="wheel_color">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <!-- Gripper -->
  <material name="gripper_color">
    <color rgba="0.8 0.1 0.1 1"/>
  </material>

  <!-- Camera -->
  <material name="camera_color">
    <color rgba="0.1 0.8 0.1 1"/>
  </material>

  <!-- Storage -->
  <material name="storage_plate_color">
    <color rgba="0.5 0.2 0.7 1"/>
  </material>

</robot>
