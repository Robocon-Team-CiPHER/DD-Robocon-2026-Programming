<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== -->
  <!-- ROS2 CONTROL PLUGIN  -->
  <!-- ===================== -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so"/>
  </gazebo>


  <!-- ===================== -->
  <!-- WHEEL CONTACT PHYSICS -->
  <!-- ===================== -->

  <!-- Front Right Wheel -->
  <gazebo reference="f_wheel_r">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Front Left Wheel -->
  <gazebo reference="f_wheel_l">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Back Right Wheel -->
  <gazebo reference="b_wheel_r">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Back Left Wheel -->
  <gazebo reference="b_wheel_l">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000</kp>
    <kd>1.0</kd>
  </gazebo>


  <!-- ===================== -->
  <!-- CAMERA SENSOR         -->
  <!-- ===================== -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>

      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera</namespace>
        </ros>
      </plugin>

    </sensor>
  </gazebo>

</robot>