<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================= -->
  <!-- ROS2 HUMBLE + IGNITION MATERIALS -->
  <!-- ================================= -->

  <!-- BASE -->
  <material name="base_color">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>

  <!-- CHASSIS -->
  <material name="chassis_color">
    <color rgba="0.60 0.60 0.60 1.0"/>
  </material>

  <!-- EXPANDABLE STRUCTURE -->
  <material name="expandable_color">
    <color rgba="0.10 0.40 0.80 1.0"/>
  </material>

  <!-- GANTRY -->
  <material name="gantry_color">
    <color rgba="0.80 0.50 0.10 1.0"/>
  </material>

  <!-- WHEELS -->
  <material name="wheel_color">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- GRIPPER -->
  <material name="gripper_color">
    <color rgba="0.80 0.10 0.10 1.0"/>
  </material>

  <!-- CAMERA -->
  <material name="camera_color">
    <color rgba="0.10 0.80 0.10 1.0"/>
  </material>

  <!-- STORAGE PLATE -->
  <material name="storage_plate_color">
    <color rgba="0.50 0.20 0.70 1.0"/>
  </material>

</robot>