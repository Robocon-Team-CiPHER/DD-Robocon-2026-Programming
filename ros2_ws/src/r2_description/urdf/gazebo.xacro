<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================= -->
  <!-- GAZEBO HARMONIC ROS2 CONTROL      -->
  <!-- ROS2 JAZZY + GAZEBO HARMONIC      -->
  <!-- ================================= -->

  <gazebo>
    <plugin
        filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    </plugin>
  </gazebo>


  <!-- ===================== -->
  <!-- WHEEL CONTACT PHYSICS -->
  <!-- ===================== -->

  <!-- Front Right Wheel -->
  <gazebo reference="f_wheel_r">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Front Left Wheel -->
  <gazebo reference="f_wheel_l">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Back Right Wheel -->
  <gazebo reference="b_wheel_r">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Back Left Wheel -->
  <gazebo reference="b_wheel_l">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>