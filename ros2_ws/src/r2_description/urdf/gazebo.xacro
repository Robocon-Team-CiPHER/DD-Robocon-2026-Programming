<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================= -->
  <!-- GAZEBO HARMONIC DIFF DRIVE       -->
  <!-- ROS 2 JAZZY + GAZEBO HARMONIC     -->
  <!-- ================================= -->

  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <!-- R2: four-wheel differential / skid-steer drive -->
      <left_joint>f_wheel_l_revolute</left_joint>
      <left_joint>b_wheel_l_revolute</left_joint>
      <right_joint>f_wheel_r_revolute</right_joint>
      <right_joint>b_wheel_r_revolute</right_joint>

      <!-- Measured from the wheel joint locations -->
      <wheel_separation>0.545</wheel_separation>
      <wheel_radius>0.06</wheel_radius>

      <!-- Explicit model-scoped Gazebo Transport topics -->
      <topic>/cmd_vel</topic>
      <odom_topic>/model/r2/odom</odom_topic>
      <tf_topic>/model/r2/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>

      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>

    <!-- Publish the four driven wheel states from Gazebo -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/model/r2/joint_states</topic>
      <joint_name>f_wheel_l_revolute</joint_name>
      <joint_name>f_wheel_r_revolute</joint_name>
      <joint_name>b_wheel_l_revolute</joint_name>
      <joint_name>b_wheel_r_revolute</joint_name>
    </plugin>
  </gazebo>


  <!-- ===================== -->
  <!-- WHEEL CONTACT PHYSICS -->
  <!-- ===================== -->

  <!-- Front Right Wheel -->
  <gazebo reference="f_wheel_r">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Front Left Wheel -->
  <gazebo reference="f_wheel_l">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Back Right Wheel -->
  <gazebo reference="b_wheel_r">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- Back Left Wheel -->
  <gazebo reference="b_wheel_l">
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <update_rate>30</update_rate>

      <camera>
        <horizontal_fov>1.047</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>

      <always_on>true</always_on>
      <visualize>true</visualize>

      <topic>camera/image</topic>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <update_rate>20</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <always_on>true</always_on>
      <visualize>true</visualize>

      <topic>scan</topic>
    </sensor>
  </gazebo>
  
</robot>