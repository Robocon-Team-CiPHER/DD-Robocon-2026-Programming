        <inertial>
            <origin xyz="-0.08600436783393724 0.013989988488398665 1.2223417510293177e-15" rpy="0.0 -0.0 0.0" />
            <mass value="1.4580482779771917" />
            <inertia ixx="0.005634036903364975" iyy="0.006850373035303139" izz="0.0018508087267253698" ixy="0.00018420936308629482" iyz="-2.4978652552286308e-17" ixz="-1.9215332864481175e-16" />
        </inertial>
