        <collision name="spearhead_finger_l_collision">
            <origin xyz="0.13250000190230252 0.2560000046766657 0.008748869216825784" rpy="1.5707963267948963 -0.0 0.0" />
            <geometry>
                <mesh filename="package://r2_description/meshes/spearhead_finger_l.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>

<!--CAMERA-->
    <link name="camera_link">
        <inertial>
            <origin xyz="0.009894465299491869 -0.012500000000000072 9.415354068752146e-15" rpy="0.0 -0.0 0.0" />
            <mass value="0.3" />
            <inertia ixx="0.00014832028606556052" iyy="0.0001429062226769995" izz="2.427338819091518e-05" ixy="8.673617379884035e-19" iyz="4.462208380571582e-20" ixz="-2.412613722866814e-17" />
        </inertial>
        <visual name="camera_link_visual">
            <origin xyz="0.052499999999999984 0.36749999999999994 -3.552713678800515e-17" rpy="1.5707963267948966 -4.6816763546921983e-97 -1.1869459682199748e-66" />
            <geometry>
                <mesh filename="package://r2_description/meshes/camera_link.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="camera_color"/>
        </visual>
        <collision name="camera_link_collision">
            <origin xyz="0.052499999999999984 0.36749999999999994 -3.552713678800515e-17" rpy="1.5707963267948966 -4.6816763546921983e-97 -1.1869459682199748e-66" />
            <geometry>
                <mesh filename="package://r2_description/meshes/camera_link.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>

<!--LIDAR-->
    <link name="lidar_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>

            <inertia
                ixx="0.0001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0001"
                iyz="0.0"
                izz="0.0001"/>
        </inertial>

        <visual name="lidar_visual">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="0.03"/>
            </geometry>
            <material name="camera_color"/>
        </visual>

        <collision name="lidar_collision">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="0.03"/>
            </geometry>
        </collision>
    </link>

<!--Storage Plate-->
    <link name="storage_plate">
        <inertial>
            <origin xyz="6.939666025053356e-16 1.4457637552194492e-16 0.0884398437074973" rpy="0.0 0.0 0.0" />
            <mass value="0.598" />
            <inertia ixx="0.014939187362813498" iyy="0.009584187362813381" izz="0.024397306664266268" ixy="1.8702121451497085e-16" iyz="3.554700142666859e-17" ixz="6.845661002964557e-17" />
        </inertial>
        <visual name="storage_plate_visual">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://r2_description/meshes/storage_plate.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="storage_plate_color"/>
        </visual>
        <collision name="storage_plate_collision">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="package://r2_description/meshes/storage_plate.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>

<!--JOINTS-->

    <!--Base link -Front-Back-Links-->
    <joint name="base_link_front_link" type="prismatic">
        <origin xyz="0.23800000000000002 0.0 -0.006025000000000001" rpy="3.141592653589793 -0.0 0.0" />
        <parent link="base_link" />
        <child link="front_link" />
        <axis xyz="0.0 0.0 1.0" />
        <limit lower="0.0" upper="0.2" effort="100" velocity="1.0"/>
        <dynamics damping="10.0" friction="2.0"/>
    </joint>
    <joint name="base_link_back_link" type="prismatic">
        <origin xyz="-0.23800000000000002 0.0 -0.006025000000000001" rpy="3.141592653589793 -0.0 0.0" />
        <parent link="base_link" />
        <child link="back_link" />
        <axis xyz="0.0 0.0 1.0" />
        <limit lower="0.0" upper="0.2" effort="100" velocity="1.0"/>
        <dynamics damping="10.0" friction="2.0"/>
    </joint>

    <!--Wheel Joints-->
    <joint name="front_link_f_wheel_r" type="continuous">
        <origin xyz="0.0 0.2715 0.0385" rpy="-1.5707963267948966 -0.0 0.0" />
        <parent link="front_link" />
        <child link="f_wheel_r" />
        <axis xyz="0.0 0.0 -1.0" />
    </joint>
    <joint name="front_link_f_wheel_l" type="continuous">
        <origin xyz="0.0 -0.2715 0.0385" rpy="1.5707963267948966 -0.0 0.0" />
        <parent link="front_link" />
        <child link="f_wheel_l" />
        <axis xyz="0.0 0.0 1.0" />
    </joint>
    <joint name="back_link_b_wheel_r" type="continuous">
        <origin xyz="0.0 0.2735 0.0385" rpy="-1.5707963267948966 -0.0 0.0" />
        <parent link="back_link" />
        <child link="b_wheel_r" />
        <axis xyz="0.0 0.0 -1.0" />
    </joint>
    <joint name="back_link_b_wheel_l" type="continuous">
        <origin xyz="0.0 -0.2735 0.0385" rpy="1.5707963267948966 -0.0 0.0" />
        <parent link="back_link" />
        <child link="b_wheel_l" />
        <axis xyz="0.0 0.0 1.0" />
    </joint>

    <!--base_link-to-V_expandable-->
    <joint name="base_link_v_expandable_r" type="prismatic">
        <origin xyz="0.0 -0.307 0.5660000000000001" rpy="1.5707963267948966 -0.0 3.141592653589793" />
        <parent link="base_link" />
        <child link="v_expandable_r" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="0.0" upper="0.2" effort="100" velocity="1.0"/>
        <dynamics damping="5.0" friction="1.0"/>
    </joint>
    <joint name="base_link_v_expandable_l" type="prismatic">
        <origin xyz="0.0 0.307 0.5660000000000001" rpy="1.5707963267948966 -0.0 0.0" />
        <parent link="base_link" />
        <child link="v_expandable_l" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="0.0" upper="0.2" effort="100" velocity="1.0"/>
        <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <!--V_expandable-to-gantry-->
    <joint name="v_expandable_r_v_gantry_r" type="prismatic">
        <origin xyz="0.0 -0.22 0.02" rpy="1.232595164407831e-32 4.479329460506062e-34 3.141592653589793" />
        <parent link="v_expandable_r" />
        <child link="v_gantry_r" />
        <axis xyz="0.0 1.0 2.1895288505075267e-47" />
        <limit lower="-0.18" upper="+0.18" effort="100" velocity="1.0"/>
        <dynamics damping="5.0" friction="1.0"/>
    </joint>
    <joint name="v_expandable_l_v_gantry_l" type="prismatic">
        <origin xyz="0.0 -0.22 0.02" rpy="0.0 -1.1947622849140125e-34 0.0" />
        <parent link="v_expandable_l" />
        <child link="v_gantry_l" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="-0.18" upper="+0.18" effort="100" velocity="1.0"/>
        <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <!--V_gantry-to-H_Expandable-->
    <joint name="v_gantry_r_to_h_expandable_r" type="fixed">
        <origin xyz="-1.0538688655686983e-34 0.0 0.017100000000000008" rpy="-1.232595164407831e-32 -4.479329460506062e-34 -9.807621084706338e-81" />
        <parent link="v_gantry_r" />
        <child link="h_expandable_r" />
    </joint>
    <joint name="v_gantry_l_to_h_expandable_l" type="fixed">
        <origin xyz="7.130076136060349e-51 0.0 0.017100000000000008" rpy="0.0 1.1947622849140125e-34 0.0" />
        <parent link="v_gantry_l" />
        <child link="h_expandable_l" />
    </joint>

    <!--Horizontal Expandable-->
    <joint name="h_expandable_r_h_gantry_r" type="prismatic">
        <origin xyz="0.0 0.0 0.02" rpy="0.0 -0.0 0.0" />
        <parent link="h_expandable_r" />
        <child link="h_gantry_r" />
        <axis xyz="0.0 0.0 1.0" />
        <limit lower="0.0" upper="0.2" effort="100" velocity="1.0"/>
        <dynamics damping="5.0" friction="1.0"/>
    </joint>
    <joint name="h_expandable_l_h_gantry_l" type="prismatic">
        <origin xyz="0.0 0.0 0.02" rpy="0.0 0.0 0.0" />
        <parent link="h_expandable_l" />
        <child link="h_gantry_l" />
        <axis xyz="0.0 1.0 0.0" />
        <limit lower="0.0" upper="0.2" effort="100" velocity="1.0"/>
        <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <!--horizontal Gantry and KFS Gripper-->    
    <joint name="h_gantry_left_kfs_gripper_gantry_l" type="fixed">
        <origin xyz="-0.0325 0.01 0.03739999999999998" rpy="0.0 0.0 0.0" />
        <parent link="h_gantry_l" />
        <child link="kfs_gripper_link" />
    </joint>
    
    <!--KFS Finger Joint-->
    <joint name="kfs_gripper_link_kfs_finger_grip" type="prismatic">
        <origin xyz="-0.012000000000000002 0.0 0.0" rpy="0.0 1.5707963267948966 0" />
        <parent link="kfs_gripper_link" />
        <child link="kfs_finger" />
        <axis xyz="1.0 0.0 0.0" />
        <limit lower="0.0" upper="0.2" effort="100" velocity="1.0"/>
    </joint>

    <!--Spearhead Gripping Joint-->
    <joint name="spearhead_body_spearhead_finger_l_grip" type="prismatic">
        <origin xyz="-0.11199999999999999 0.025 -2.089831575765001e-18" rpy="3.141592653589793 1.4351862472329628e-62 3.4454487729021107e-46" />
        <parent link="spearhead_body" />
        <child link="spearhead_finger_l" />
        <axis xyz="-1.4449768080836794e-62 0.0 1.0" />
        <limit lower="-0.05" upper="0.05" effort="100" velocity="1.0"/>
    </joint>
    <joint name="spearhead_body_spearhead_finger_r_grip" type="prismatic">
        <origin xyz="-0.08199999999999999 0.025 -2.089831575765001e-18" rpy="3.141592653589793 1.4351862472329628e-62 3.4454487729021107e-46" />
        <parent link="spearhead_body" />
        <child link="spearhead_finger_r" />
        <axis xyz="-1.4449768080836794e-62 0.0 1.0" />
        <limit lower="-0.05" upper="0.05" effort="100" velocity="1.0"/>
    </joint>

    <!--Spearhead Revolute-->
    <joint name="kfs_gripper_link_spearhead_gripper_rotate" type="revolute">
        <origin xyz="0.0 0.12 0.2125" rpy="-3.141592653589793 -0.0 0.0" />
        <parent link="kfs_gripper_link" />
        <child link="spearhead_body" />
        <axis xyz="0.0 8.359326303060002e-17 1.0" />
        <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="100" velocity="1.0"/>
    </joint>

    <!--CAMERA Rotation-->
    <joint name="kfs_gripper_link_camera_rotate" type="revolute">
        <origin xyz="0.0 0.0 0.2125" rpy="3.944304526105059e-31 -0.0 1.1869459682199748e-66" />
        <parent link="kfs_gripper_link" />
        <child link="camera_link" />
        <axis xyz="0.0 3.944304526105059e-31 1.0" />
        <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="100" velocity="1.0"/>
    </joint>

    <!--LIDAR Joint-->
    <joint name="base_to_lidar" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
    </joint>
    
    <!--Storage Plate Joint-->
    <joint name="base_to_storage_plate" type="fixed">
        <parent link="base_link"/>
        <child link="storage_plate"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

<!-- ================================= -->
<!-- GAZEBO HARMONIC + ROS2 JAZZY -->
<!-- ================================= -->

<!-- GAZEBO ROS2 CONTROL PLUGIN -->
    <gazebo>
        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        </plugin>
    </gazebo>

    <!-- CAMERA SENSOR -->
    <gazebo reference="camera_link">

        <sensor name="camera_sensor" type="camera">

            <always_on>true</always_on>

            <update_rate>30</update_rate>

            <visualize>true</visualize>

            <topic>camera/image_raw</topic>

            <camera>

                <horizontal_fov>1.047</horizontal_fov>

                <image>

                    <width>640</width>
                    <height>480</height>

                    <format>R8G8B8</format>

                </image>

                <clip>

                    <near>0.1</near>
                    <far>100.0</far>

                </clip>

            </camera>

        </sensor>

    </gazebo>

    <!-- LIDAR SENSOR -->
    <gazebo reference="base_link">

        <sensor name="lidar_sensor" type="ray">

            <pose>0 0 0.25 0 0 0</pose>

            <always_on>true</always_on>

            <visualize>true</visualize>

            <update_rate>10</update_rate>

            <topic>scan</topic>

            <lidar>

                <scan>

                    <horizontal>

                        <samples>720</samples>

                        <resolution>1</resolution>

                        <min_angle>-3.14159</min_angle>

                        <max_angle>3.14159</max_angle>

                    </horizontal>

                </scan>

                <range>

                    <min>0.10</min>

                    <max>12.0</max>

                    <resolution>0.01</resolution>

                </range>

            </lidar>

        </sensor>

    </gazebo>

    <!-- WHEEL FRICTION -->

    <gazebo reference="f_wheel_r">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>100000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="f_wheel_l">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>100000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="b_wheel_r">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>100000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="b_wheel_l">
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>100000.0</kp>
        <kd>1.0</kd>
    </gazebo>

    <!-- ROS2 CONTROL -->

    <ros2_control name="IgnitionSystem" type="system">

        <hardware>

            <plugin>ign_ros2_control/IgnitionSystem</plugin>

        </hardware>

        <!-- FRONT RIGHT -->
        <joint name="front_link_f_wheel_r">

            <command_interface name="velocity"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

        <!-- FRONT LEFT -->
        <joint name="front_link_f_wheel_l">

            <command_interface name="velocity"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

        <!-- BACK RIGHT -->
        <joint name="back_link_b_wheel_r">

            <command_interface name="velocity"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

        <!-- BACK LEFT -->
        <joint name="back_link_b_wheel_l">

            <command_interface name="velocity"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

    </ros2_control>

</robot>