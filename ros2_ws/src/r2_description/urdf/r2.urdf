            <inertia ixx="2.506499874757595e-05" iyy="0.0009802969467722182" izz="0.0009816202967382268" ixy="2.7755575615628914e-17" iyz="-6.559423143537302e-18" ixz="-5.176100770984052e-06" />
        </inertial>
        <visual name="spearhead_finger_r_visual">
