            <geometry>
                <mesh filename="package://r2_description/meshes/spearhead_finger_r.stl" scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
    </link>
    <!--left finger-->
    <link name="spearhead_finger_l">
        <inertial>
            <origin xyz="-0.02790307713902619 4.676666343073066e-09 -0.007694364948372371" rpy="0.0 -0.0 0.0" />
            <mass value="0.058" />
            <inertia ixx="2.5064998747569012e-05" iyy="0.0009802969467739252" izz="0.0009816202967399268" ixy="2.42861286636753e-17" iyz="-7.589415207398531e-18" ixz="5.176100770980284e-06" />
        </inertial>
        <visual name="spearhead_finger_l_visual">
