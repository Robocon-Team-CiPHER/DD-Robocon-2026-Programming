<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_bringup</name>
  <version>1.0.0</version>
  <description>
    Top-level launch files for R2 competition robot.
    Provides launch configurations for: full robot, detection-only,
    actuation-only, initialization-only, and simulation/test mode.
  </description>

  <maintainer email="tejas@r2robot.local">Tejas Raut</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>r2_interfaces</exec_depend>
  <exec_depend>r2_description</exec_depend>
  <exec_depend>r2_detection</exec_depend>
  <exec_depend>r2_actuation</exec_depend>
  <exec_depend>r2_initialization</exec_depend>
  <exec_depend>r2_comm_bridge</exec_depend>
  <exec_depend>r2_mission_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
