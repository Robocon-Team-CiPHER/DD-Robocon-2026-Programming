# ExpandMechanism.action
# Long-running action: extend or retract a linear mechanism

# GOAL
string  mechanism_id         # "horizontal_expansion" | "vertical_expansion"
uint8   direction            # 0=RETRACT, 1=EXTEND
float32 target_position_mm   # Desired final position
float32 speed_percent        # Motor duty cycle 0–100
---
# RESULT
bool    success
float32 actual_position_mm
string  message
---
# FEEDBACK
float32 current_position_mm
bool    limit_min_active
bool    limit_max_active
