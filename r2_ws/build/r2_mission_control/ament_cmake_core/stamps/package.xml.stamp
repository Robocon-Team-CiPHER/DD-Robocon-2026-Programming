<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_mission_control</name>
  <version>1.0.0</version>
  <description>
    High-level mission state machine for R2 competition robot.
    Orchestrates the three game regions: Martial Club → Meihua Forest → Martial Arena.
    Uses ROS 2 action clients to command subsystems.
  </description>

  <maintainer email="tejas@r2robot.local">Tejas Raut</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>r2_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
