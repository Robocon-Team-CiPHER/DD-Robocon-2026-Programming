<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_initialization</name>
  <version>1.0.0</version>
  <description>
    Boot-time initialization nodes for R2.
    system_check_node: verifies hardware (cameras, serial ports).
    esp32_handshake_node: sends init sequence and waits for ACK.
    startup_monitor_node: monitors all nodes ready before signalling go.
  </description>

  <maintainer email="tejas@r2robot.local">Tejas Raut</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>r2_interfaces</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
