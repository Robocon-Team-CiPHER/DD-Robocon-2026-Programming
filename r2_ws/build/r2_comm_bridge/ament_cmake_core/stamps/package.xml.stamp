<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_comm_bridge</name>
  <version>1.0.0</version>
  <description>
    Serial communication bridge between ROS 2 and hardware controllers.
    serial_bridge_node: Raspberry Pi ↔ ESP32 (USB Serial)
    arduino_bridge_node: ESP32 ↔ Arduino Mega (UART relay or direct USB)
    Uses a simple [START][CMD][LEN][DATA][CRC] framing protocol.
  </description>

  <maintainer email="tejas@r2robot.local">Tejas Raut</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>r2_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
