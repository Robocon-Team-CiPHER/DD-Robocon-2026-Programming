<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_actuation</name>
  <version>1.0.0</version>
  <description>
    C++ actuation nodes for R2: chassis controller, step climber, spearhead gripper,
    KFS gripper, horizontal expansion, and vertical expansion.
    All nodes communicate with the comm_bridge to reach ESP32 / Arduino Mega.
  </description>

  <maintainer email="tejas@r2robot.local">Tejas Raut</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>r2_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
