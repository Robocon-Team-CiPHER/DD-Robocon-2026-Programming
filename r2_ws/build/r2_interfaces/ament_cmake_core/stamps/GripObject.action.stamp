# GripObject.action
# Long-running action: grip or release an object with a specified gripper

# GOAL
string  gripper_id           # "spearhead" | "kfs"
uint8   command              # 0=RELEASE, 1=GRIP, 2=ROTATE_AND_DOCK
float32 target_angle_deg     # For spearhead servo rotation (0 if unused)
---
# RESULT
bool    success
string  message
float32 grip_force_estimate  # Estimated (0–100), 0 if unavailable
---
# FEEDBACK
string  phase                # Current gripper phase description
float32 progress_percent     # 0–100
